{
  "_comment": [
    "資格情報マスクの共有フィクスチャ。gateway の secret-scrubber.ts と",
    "ai-engine の pii_screener.py が **同じ** 期待に対してテストされる。",
    "二段構えの防御は、二段目が一段目と同じ盲点を持っていたら二重防御にならない。",
    "片方にだけ規則を足すと、このフィクスチャを通すもう片方のテストが落ちる。",
    "新しいプロバイダのキー形式を見つけたら、まずここに1件足すこと。",
    "",
    "⚠️ 値は **assemble の断片を実行時に結合して**組み立てる。ベタ書きしない。",
    "   本物そっくりの形でないとスクラバーを試験できないが、そのままファイルに書くと",
    "   GitHub の secret scanning が本物と判定して push をブロックする（実際にされた）。",
    "   偽物を例外登録させると、次から本物の警告も素通しする癖がつくので、そちらは採らない。",
    "   textTemplate の {{名前}} を assemble[名前] の結合結果で置換し、",
    "   mustVanish に挙げた名前の値が出力から消えていることを検証する。"
  ],
  "mustMask": [
    {
      "name": "Anthropic APIキー",
      "textTemplate": "curl -H \"Authorization: Bearer {{k}}\" https://api.anthropic.com/v1/messages",
      "assemble": {
        "k": {
          "join": "-",
          "parts": [
            "sk",
            "ant",
            "api03",
            "abcdefghijklmnopqrstuvwxyz"
          ]
        }
      },
      "mustVanish": [
        "k"
      ]
    },
    {
      "name": "OpenAI APIキー",
      "textTemplate": "OPENAI_API_KEY={{k}}",
      "assemble": {
        "k": {
          "join": "-",
          "parts": [
            "sk",
            "proj",
            "AbCdEfGhIjKlMnOpQrStUvWxYz0123456789"
          ]
        }
      },
      "mustVanish": [
        "k"
      ]
    },
    {
      "name": "Stripe シークレットキー (curl -u。アンダースコア区切りで sk- 規則に当たらない)",
      "textTemplate": "curl https://api.stripe.com/v1/customers -u {{k}}: -d name=test",
      "assemble": {
        "k": {
          "join": "_",
          "parts": [
            "sk",
            "live",
            "51NxAbCdEfGhIjKlMnOpQrSt"
          ]
        }
      },
      "mustVanish": [
        "k"
      ]
    },
    {
      "name": "Stripe 制限付きキー",
      "textTemplate": "STRIPE_KEY={{k}}",
      "assemble": {
        "k": {
          "join": "_",
          "parts": [
            "rk",
            "test",
            "AbCdEfGhIjKlMnOpQrStUvWx"
          ]
        }
      },
      "mustVanish": [
        "k"
      ]
    },
    {
      "name": "SendGrid APIキー (ドット区切りで base64 規則の lookbehind に弾かれる)",
      "textTemplate": "curl -X POST -H \"X-SG: {{k}}\" https://api.sendgrid.com/v3/mail/send",
      "assemble": {
        "k": {
          "join": ".",
          "parts": [
            "SG",
            "abcdefghijklmnop",
            "qrstuvwxyz0123456789"
          ]
        }
      },
      "mustVanish": [
        "k"
      ]
    },
    {
      "name": "SendGrid キー (環境変数形式。SENDGRID_API_KEY は \\b が立たない)",
      "textTemplate": "SENDGRID_API_KEY={{k}}",
      "assemble": {
        "k": {
          "join": ".",
          "parts": [
            "SG",
            "abcdefghijklmnop",
            "qrstuvwxyz0123456789"
          ]
        }
      },
      "mustVanish": [
        "k"
      ]
    },
    {
      "name": "Twilio (32桁hex。汎用 hex 規則は40桁以上なので拾えない)",
      "textTemplate": "curl -u {{sid}}:{{k}} https://api.twilio.com/2010-04-01/Accounts.json",
      "assemble": {
        "sid": {
          "join": "",
          "parts": [
            "AC1234567890abcdef",
            "1234567890abcdef"
          ]
        },
        "k": {
          "join": "",
          "parts": [
            "0123456789abcdef",
            "0123456789abcdef"
          ]
        }
      },
      "mustVanish": [
        "k"
      ]
    },
    {
      "name": "Slack ボットトークン",
      "textTemplate": "SLACK_BOT_TOKEN={{k}}",
      "assemble": {
        "k": {
          "join": "-",
          "parts": [
            "xoxb",
            "1234567890",
            "1234567890123",
            "AbCdEfGhIjKlMnOpQrStUvWx"
          ]
        }
      },
      "mustVanish": [
        "k"
      ]
    },
    {
      "name": "GitHub Personal Access Token",
      "textTemplate": "git remote set-url origin https://{{k}}@github.com/x/y.git",
      "assemble": {
        "k": {
          "join": "_",
          "parts": [
            "ghp",
            "AbCdEfGhIjKlMnOpQrStUvWxYz0123"
          ]
        }
      },
      "mustVanish": [
        "k"
      ]
    },
    {
      "name": "AWS アクセスキーID",
      "textTemplate": "aws configure set aws_access_key_id {{k}}",
      "assemble": {
        "k": {
          "join": "",
          "parts": [
            "AKIAIOSFOD",
            "NN7EXAMPLE"
          ]
        }
      },
      "mustVanish": [
        "k"
      ]
    },
    {
      "name": "Google APIキー",
      "textTemplate": "https://maps.googleapis.com/maps/api/js?key={{k}}",
      "assemble": {
        "k": {
          "join": "",
          "parts": [
            "AIzaSyD-1234567890",
            "abcdefghijklmnopqrstu"
          ]
        }
      },
      "mustVanish": [
        "k"
      ]
    },
    {
      "name": "Authorization: Basic (base64)",
      "textTemplate": "curl -H \"Authorization: Basic {{k}}\" https://api.example.com/v1/me",
      "assemble": {
        "k": {
          "join": "",
          "parts": [
            "dXNlcjpw",
            "YXNzd29yZA=="
          ]
        }
      },
      "mustVanish": [
        "k"
      ]
    },
    {
      "name": "curl --user のパスワード",
      "textTemplate": "curl --user \"bob:{{k}}\" https://api.example.com/v1/me",
      "assemble": {
        "k": {
          "join": "-",
          "parts": [
            "s3cret",
            "pass"
          ]
        }
      },
      "mustVanish": [
        "k"
      ]
    },
    {
      "name": "URL の userinfo に埋め込まれたパスワード",
      "textTemplate": "psql https://admin:{{k}}@db.example.com/app",
      "assemble": {
        "k": {
          "join": "",
          "parts": [
            "hunt",
            "er2"
          ]
        }
      },
      "mustVanish": [
        "k"
      ]
    },
    {
      "name": "汎用 key=value",
      "textTemplate": "設定は client_secret: {{k}} です",
      "assemble": {
        "k": {
          "join": "",
          "parts": [
            "aBcDeFgHiJ",
            "kLmNoPqRsT1234"
          ]
        }
      },
      "mustVanish": [
        "k"
      ]
    }
  ],
  "mustNotMask": [
    {
      "name": "Basic authentication という英文",
      "text": "This endpoint requires Basic authentication over TLS."
    },
    {
