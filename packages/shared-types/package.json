{
  "name": "@org-ai/shared-types",
  "version": "1.0.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.include=src/**"
  },
  "dependencies": {
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.6",
    "typescript": "^5.0.0",
    "vitest": "^4.1.6"
  }
}
