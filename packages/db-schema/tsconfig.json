{
  // prisma/*.ts（seed）の型チェック用。@org-ai/shared-types はソースを直接見る（dist の事前ビルドに依存しない）。
  // 実行（ts-node）は CommonJS で dist を読むので、`npm run seed` が先に shared-types をビルドする。
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "paths": {
      "@org-ai/shared-types": ["../shared-types/src/index.ts"]
    }
  },
  "include": ["prisma/**/*.ts"]
}
