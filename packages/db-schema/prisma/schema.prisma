datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  name         String
  /// 'OWNER' | 'ADMIN' | 'MEMBER'（shared-types の UserRole で縛る。DB enum にはしない）
  /// ⚠️ DEFAULT を 'OWNER' から 'MEMBER' に変えてある。role を省略した INSERT が
  ///    黙って最強権限を作るのを塞ぐため（fail-closed）。既存行の値は変えていない。
  role         String        @default("MEMBER")
  /// 'ACTIVE' | 'DISABLED'。退職者は物理削除しない
  /// （Agent.createdBy / Capability.createdBy などの User.id 参照を壊さないため）
  status       String        @default("ACTIVE")
  orgId        String?
  org          Organization? @relation(fields: [orgId], references: [id])
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

/// 招待。管理者が発行し、リンクを手渡す（口頭・Slack・LINE 等）。
///
/// ⚠️ メール送信はこのプロダクトに存在しない（nodemailer/resend/SES すべて依存に無い）。
///    メール前提の招待にすると永久に動かないので、リンクを手渡す方式にしてある。
///    あとからメール送付を足すときは、この行を作った直後に送るだけでよい。
///
/// ⚠️ トークンはハッシュだけを保存する。生値は発行時のレスポンスに1回出るきり。
///    DB が読まれても招待を成立させられないようにするため（OAuth state と同じ流儀）。
model Invitation {
  id         String       @id @default(cuid())
  orgId      String
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  /// 招待する相手の目印。メールは送らないので、識別のためだけに持つ（任意）
  email      String?
  /// 受諾したときに付与する役割。'ADMIN' | 'MEMBER'（OWNER は招待で渡さない）
  role       String       @default("MEMBER")
  /// sha256(生トークン)。生値は保存しない
  tokenHash  String       @unique
  expiresAt  DateTime
  /// 使い切り。受諾した時刻が入る
  acceptedAt DateTime?
  acceptedBy String?
  /// 発行を取り消した時刻
  revokedAt  DateTime?
  createdBy  String
  createdAt  DateTime     @default(now())

  @@index([orgId, createdAt])
}

model Organization {
  id                  String               @id @default(cuid())
  name                String
  /// 'STARTER' | 'PRO' | 'MAX'。**プランの真実の源はここ**。
  /// Subscription.plan は Stripe 側の申告のミラーで、食い違いは検知対象。
  plan                String               @default("STARTER")
  billingEmail        String?
  /// Stripe の顧客ID。決済を繋いだ組織にだけ入る
  stripeCustomerId    String?
  /// 使用中のストレージ量（バイト）。**使用量の正本はこのカウンタ**で、
  /// UploadedFile の SUM は復旧時の再計算にだけ使う
  /// （毎回 SUM すると一覧のたびに全表走査になる）
  storageUsedBytes    BigInt               @default(0)
  users               User[]
  invitations         Invitation[]
  sessions            ChatSession[]
  tasks               Task[]
  files               UploadedFile[]
  scheduledTasks      ScheduledTask[]
  agents              Agent[]
  deals               Deal[]
  channelConnections  ChannelConnection[]
  inboundMessages     InboundMessage[]
  providerConnections ProviderConnection[]
  projects            Project[]
  costEntries         CostEntry[]
  vendors             Vendor[]
  createdAt           DateTime             @default(now())
}

model ChatSession {
  id        String       @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id])
  title     String?
  messages  Message[]
  createdAt DateTime     @default(now())
}

model Message {
  id         String            @id @default(cuid())
  sessionId  String
  session    ChatSession       @relation(fields: [sessionId], references: [id])
  role       String
  content    String
  department String?
  createdAt  DateTime          @default(now())
  embedding  MessageEmbedding?
}

model Task {
  id              String       @id @default(cuid())
  orgId           String
  org             Organization @relation(fields: [orgId], references: [id])
  title           String
  status          String       @default("PENDING")
  department      String
  taskType        String?
  input           String
  output          String?
  approvalData    String?
  n8nWorkflowId   String?
  executionResult String?
  retryCount      Int          @default(0)
  lastError       String?
  executedAt      DateTime?
  // SNS 下書き等の予約投稿日時。従来は output JSON 内に持っていたが、索引・カレンダー集計のためカラム化。
  // 実投稿はしない（メタデータのみ）。status は String のまま（DB enum 化は本番の migrate deploy 失敗リスクを避けるため見送り）。
  scheduledAt     DateTime?
  agentId         String?
  agent           Agent?       @relation(fields: [agentId], references: [id])
  logs            TaskLog[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([orgId, agentId])
  @@index([orgId, scheduledAt])
}

model TaskLog {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id])
  message   String
  level     String   @default("INFO")
  createdAt DateTime @default(now())
}

model AILog {
  id         String   @id @default(cuid())
  orgId      String
  department String
  provider   String
  model      String
  inputText  String
  outputText String?
  tokens     Int?
  latencyMs  Int?
  riskScore  Float?
  createdAt  DateTime @default(now())
}

model RiskEvent {
  id          String   @id @default(cuid())
  orgId       String
  aiLogId     String?
  type        String
  description String
  severity    String
  resolved    Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model UploadedFile {
  id           String       @id @default(cuid())
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id])
  uploadedBy   String
  originalName String
  storagePath  String
  mimeType     String
  sizeBytes    Int
  createdAt    DateTime     @default(now())
  chunks       FileChunk[]
}

/// RAG: アップロードファイルをチャンク分割し埋め込みベクトルを保持する。
/// embedding は pgvector の vector 型（Prisma 未対応のため Unsupported）。読み書きは $queryRaw / $executeRaw。
model FileChunk {
  id         String                       @id @default(cuid())
  orgId      String
  fileId     String
  file       UploadedFile                 @relation(fields: [fileId], references: [id], onDelete: Cascade)
  chunkIndex Int
  content    String
  embedding  Unsupported("vector(1024)")?
  createdAt  DateTime                     @default(now())

  @@index([orgId])
  @@index([fileId])
}

/// RAG: チャットメッセージの埋め込み（過去履歴の横断参照用）。content を非正規化保持。
model MessageEmbedding {
  id        String                       @id @default(cuid())
  orgId     String
  messageId String                       @unique
  message   Message                      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  sessionId String
  role      String
  content   String
  embedding Unsupported("vector(1024)")?
  createdAt DateTime                     @default(now())

  @@index([orgId])
}

model ScheduledTask {
  id             String       @id @default(cuid())
  orgId          String
  org            Organization @relation(fields: [orgId], references: [id])
  title          String
  department     String
  taskType       String
  input          String
  recipientEmail String?
  frequency      String
  hourUtc        Int
  dayOfWeek      Int?
  dayOfMonth     Int?
  enabled        Boolean      @default(true)
  lastRunAt      DateTime?
  // 定期実行トリガー: 紐づく Agent。null なら従来どおり部署ワークフロー実行。
  // Agent 削除時は SetNull（routes/agents.ts の DELETE が定期タスク自体も掃除する）。
  agentId        String?
  agent          Agent?       @relation(fields: [agentId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([orgId, enabled])
  @@index([agentId])
}

enum CapabilityStatus {
  ACTIVE
  NEEDS_AUTH
  DISABLED
}

enum CredentialStatus {
  CONNECTED
  DISCONNECTED
}

model Capability {
  id            String               @id @default(cuid())
  orgId         String
  name          String
  displayName   String
  description   String
  department    String
  inputSchema   Json
  status        CapabilityStatus     @default(NEEDS_AUTH)
  n8nWorkflowId String?
  webhookPath   String?
  /// 'n8n' | 'http'。'native' は adapter レジストリからの派生表示値で DB には保存しない
  /// （保存すると backfill が必要になり、adapter の増減と二重管理になる）。
  kind          String               @default("n8n")
  /// kind='http' のときのみ有効。ユーザーが定義した外部 API 呼び出しの設定。
  /// ⚠️ headers[].value は secret=true のとき secret-box の暗号文のみを持つ（平文禁止）。
  /// ⚠️ この列を含む行を API レスポンスへ生で流さないこと（sanitizeCapability 必須）。
  httpConfig    Json?
  /// カスタムノードを作成した User.id（監査用）。seed 由来は null。
  createdBy     String?
  requiredCreds RequiredCredential[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@unique([orgId, name])
  @@index([orgId, status])
  @@index([orgId, kind])
}

model RequiredCredential {
  id            String           @id @default(cuid())
  capabilityId  String
  capability    Capability       @relation(fields: [capabilityId], references: [id], onDelete: Cascade)
  provider      String
  status        CredentialStatus @default(DISCONNECTED)
  lastCheckedAt DateTime?

  @@index([capabilityId])
}

model CapabilityGap {
  id           String   @id @default(cuid())
  orgId        String
  requestedBy  String
  rawRequest   String
  inferredName String?
  count        Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([orgId, inferredName])
  @@index([orgId, createdAt])
}

model ExecutionLog {
  id           String   @id @default(cuid())
  orgId        String
  capabilityId String?
  status       String
  errorType    String?
  requestArgs  Json
  responseData Json?
  createdAt    DateTime @default(now())

  @@index([orgId, createdAt])
  @@index([capabilityId])
}

enum AgentN8nStatus {
  PENDING // n8n ワークフロー未作成（API 不達 / スキップ）
  CREATED // 作成済みだが activate 未確認
  ACTIVE // 作成 + activate 済み
  FAILED // 生成を試みて失敗
  FALLBACK_ONLY // 意図的に n8n ワークフローを持たない（常に AI Engine で実行）
}

enum AgentTrigger {
  MANUAL
  SCHEDULED
}

/// ユーザーがチャット / フォームから作成する再利用可能な「業務効率化エージェント」。
/// DB の行が真実の源。n8n は best-effort の自動化レイヤーで、寝ていても AI Engine で実行される。
model Agent {
  id            String         @id @default(cuid())
  orgId         String
  org           Organization   @relation(fields: [orgId], references: [id])
  name          String
  description   String?
  department    String         @default("GENERAL")
  instructions  String // system プロンプト / ペルソナ
  steps         Json? // 順序付き capability ステップ: [{ capabilityName, argTemplate }]
  trigger       AgentTrigger   @default(MANUAL)
  enabled       Boolean        @default(true)
  // n8n linkage
  n8nWorkflowId String?
  webhookPath   String? // 例: "agent-<id>"
  n8nStatus     AgentN8nStatus @default(PENDING)
  // 表示用（保存エージェントを built-in と並べて描画するため）
  icon          String?
  color         String?
  createdBy     String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  tasks          Task[]
  scheduledTasks ScheduledTask[]

  @@unique([orgId, name])
  @@index([orgId, enabled])
}

/// 建設業の「工事（現場）」。経理はすべてこの単位で回る。
/// 一般の経費精算と違い、原価は材料費・労務費・外注費・経費の4分類で持つ
/// （2025年12月全面施行の改正建設業法で、見積書への内訳記載が努力義務になった区分でもある）。
/// 金額はすべて円単位の Int（小数を持ち込まない）。
model Project {
  id             String       @id @default(cuid())
  orgId          String
  org            Organization @relation(fields: [orgId], references: [id])
  /// 社内の工事番号
  code           String
  name           String
  /// 発注者（元請・施主）
  client         String?
  /// 請負金額（税抜・円）
  contractAmount Int          @default(0)
  startOn        DateTime?
  dueOn          DateTime?
  /// ESTIMATING | ORDERED | IN_PROGRESS | COMPLETED | BILLED | PAID
  status         String       @default("ESTIMATING")
  /// 実行予算の4分類（円）
  budgetMaterial Int          @default(0)
  budgetLabor    Int          @default(0)
  budgetSubcon   Int          @default(0)
  budgetOther    Int          @default(0)
  /// 出来高（%）
  progressRate   Int          @default(0)
  note           String?
  costEntries    CostEntry[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([orgId, code])
  @@index([orgId, status])
}

/// 取引先。建設業では一人親方（SOLO）が多く、インボイス登録の有無が
/// そのまま元請の控除額に効く（2026年10月に経過措置が80%→70%へ下がる）。
/// 「外注費か給与か」は税務調査の重点項目なので kind を分けて持つ。
model Vendor {
  id                String       @id @default(cuid())
  orgId             String
  org               Organization @relation(fields: [orgId], references: [id])
  name              String
  /// SUBCON（下請）| SUPPLIER（資材）| SOLO（一人親方）| OTHER
  kind              String       @default("SUBCON")
  /// 適格請求書発行事業者として登録済みか
  invoiceRegistered Boolean      @default(false)
  /// 登録番号（T + 13桁）
  invoiceNumber     String?
  note              String?
  costEntries       CostEntry[]
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@unique([orgId, name])
  @@index([orgId, invoiceRegistered])
}

/// 工事にひもづく原価明細。
/// source=LINE は現場から送られた領収書を AI が読み取ったもので、
/// status=DRAFT のあいだは「AI が読んだが人が未確認」を意味する。
model CostEntry {
  id          String       @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id])
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vendorId    String?
  vendor      Vendor?      @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  incurredOn  DateTime
  /// MATERIAL（材料費）| LABOR（労務費）| SUBCON（外注費）| OTHER（経費）
  category    String
  /// 本体価格（税抜・円）。請負金額も税抜なので、粗利は税抜どうしで引ける
  amount      Int
  /// 消費税額（円）。自社雇用の労務費など不課税なら 0。
  /// 一律10%と仮定しないのは、労務費が大きい建設業で仮定すると
  /// インボイスの負担試算が大きくずれるため
  taxAmount   Int          @default(0)
  description String?
  /// MANUAL | CHAT | LINE
  source      String       @default("MANUAL")
  /// DRAFT（未確認）| CONFIRMED（確定）
  status      String       @default("DRAFT")
  createdBy   String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([orgId, projectId, incurredOn])
  @@index([orgId, status])
}

/// 営業パイプラインの商談。従来は routes/sales/pipeline.ts のインメモリ Map（再起動で消える）だったが、
/// 永続化のためテーブル化。stage は String（'LEAD' | 'NEGOTIATION' | 'PROPOSAL' | 'WON'）で、
/// 値域の enforcement は shared-types の PipelineStage 型 + zod で行う（DB enum にはしない）。
model Deal {
  id        String       @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id])
  title     String
  company   String?
  amount    Int          @default(0)
  stage     String       @default("LEAD")
  ownerId   String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([orgId, stage])
}

/// 組織単位の外部プロバイダ接続（Slack Bot トークン / Google OAuth）。設定 > 連携から
/// 顧客がセルフサーブで接続する。トークンは secret-box.ts の AES-256-GCM 暗号文のみ保存し、
/// 平文は DB・ログ・レスポンスに出さない。capability 実行（native adapter）がここを参照する。
/// ChannelConnection とは統合しない: あちらは @@unique([provider, channelId])（webhook の
/// destination 逆引き＝全 org 横断で一意）、こちらは @@unique([orgId, provider])（1組織1接続）
/// と unique の意味論が異なる。
model ProviderConnection {
  id                String       @id @default(cuid())
  orgId             String
  org               Organization @relation(fields: [orgId], references: [id])
  provider          String // 'slack' | 'google'（shared-types の ProviderConnectionProvider で縛る）
  accessTokenEnc    String // Slack: xoxb Bot token / Google: access_token（いずれも暗号文）
  refreshTokenEnc   String? // Google のみ。access_token 失効時の自動リフレッシュに使う
  tokenExpiresAt    DateTime? // Google access_token の期限。Slack は null（無期限）
  scopes            String? // スペース区切り。Slack は auth.test の x-oauth-scopes ヘッダ値
  externalAccountId String? // Slack: team_id / Google: アカウント email
  displayName       String? // Slack: ワークスペース名 / Google: アカウント email
  status            String       @default("CONNECTED") // 'CONNECTED' | 'NEEDS_RECONNECT' | 'DISABLED'
  lastCheckedAt     DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@unique([orgId, provider])
  @@index([orgId])
}

/// LINE 受信箱: テナント（org）と LINE 公式アカウントの接続情報。
/// channelSecret / accessToken は secret-box.ts の AES-256-GCM 暗号文のみ保存し、平文は保存しない。
/// channelId は LINE の destination（bot userId、GET /v2/bot/info の userId）。
/// webhook は全テナント共通 1 本で、destination から provider+channelId で逆引きする。
model ChannelConnection {
  id               String       @id @default(cuid())
  orgId            String
  org              Organization @relation(fields: [orgId], references: [id])
  provider         String       @default("line")
  channelId        String // LINE: destination (bot userId, GET /v2/bot/info の userId)
  displayName      String?
  channelSecretEnc String // secret-box.ts の AES-256-GCM 暗号文。平文は保存しない
  accessTokenEnc   String
  status           String       @default("ACTIVE") // 'ACTIVE' | 'DISABLED'
  monthlyPushCount Int          @default(0)
  pushCountMonth   String? // 'YYYY-MM'。月替りで lazy リセット
  lastEventAt      DateTime?
  lastCheckedAt    DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  inboundMessages InboundMessage[]

  @@unique([provider, channelId])
  @@index([orgId, provider])
}

/// LINE 受信箱: 受信メッセージと AI 下書き・承認送信の状態。
/// webhookEventId の unique が LINE 再送の dedupe 本体（P2002 を静かに握る）。
/// replyToken は使わない・保存しない（承認 API が push で送信するため期限切れの概念を持ち込まない）。
model InboundMessage {
  id             String             @id @default(cuid())
  orgId          String
  org            Organization       @relation(fields: [orgId], references: [id])
  connectionId   String?
  connection     ChannelConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  provider       String             @default("line")
  webhookEventId String
  sourceType     String // 'group' | 'room' | 'user'
  groupId        String? // group の groupId / room の roomId（返信先。user の場合は null）
  lineUserId     String?
  senderName     String?
  messageType    String             @default("text")
  text           String?
  status         String             @default("RECEIVED") // RECEIVED|DRAFTED|DRAFT_FAILED|SENT|REJECTED|SEND_FAILED|SKIPPED
  draft          String?
  draftModel     String?
  draftError     String?
  replyText      String?
  repliedAt      DateTime?
  repliedBy      String?
  rejectedReason String?
  lastError      String?
  receivedAt     DateTime
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([provider, webhookEventId])
  @@index([orgId, status, createdAt])
  @@index([connectionId, groupId, createdAt])
}
