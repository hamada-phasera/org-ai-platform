{
  "name": "org-ai-platform",
  "private": true,
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.19.0"
  },
  "workspaces": [
    "apps/web",
    "apps/api-gateway",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=apps/api-gateway\" \"npm run dev --workspace=apps/web\"",
    "build": "turbo build",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present && npm run test:scripts",
    "test:scripts": "node --test scripts/__tests__/*.test.mjs",
    "test:int": "npm run test:int --workspace=apps/api-gateway",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "prisma:generate": "npm run generate --workspace=packages/db-schema",
    "lint:ai": "cd apps/ai-engine && .venv/bin/ruff check .",
    "typecheck:ai": "cd apps/ai-engine && .venv/bin/mypy",
    "test:ai": "cd apps/ai-engine && .venv/bin/python -m pytest -q",
    "test:go": "cd usage-metrics-svc && go vet ./... && go test ./...",
    "n8n:status": "node scripts/n8n-status.mjs",
    "n8n:convert": "node scripts/n8n-convert-webhook.mjs",
    "n8n:import": "node scripts/n8n-import-workflows.mjs",
    "render:status": "node scripts/render-deploy.mjs status",
    "render:set-env": "node scripts/render-deploy.mjs set-env",
    "render:set-plan": "node scripts/render-deploy.mjs set-plan",
    "render:rewire": "node scripts/render-deploy.mjs rewire",
    "render:deploy": "node scripts/render-deploy.mjs deploy",
    "render:verify": "node scripts/render-deploy.mjs verify",
    "supabase:check": "node scripts/supabase-setup.mjs",
    "supabase:setup": "node scripts/supabase-setup.mjs --apply",
    "stripe:bootstrap": "node scripts/stripe-bootstrap.mjs",
    "ontology:check": "node scripts/ontology-drift.mjs ontology/org.json ontology/observed.json --out ontology/out",
    "ontology:ttl": "mkdir -p ontology/out && node scripts/ontology-export-ttl.mjs ontology/org.json > ontology/out/org.ttl",
    "check:deploy": "node scripts/check-deploy-config.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^8.0.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "turbo": "^2.0.0",
    "typescript-eslint": "^8.72.2",
    "yaml": "^2.9.1"
  }
}
