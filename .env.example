# ==========================================================================
# FLOW / org-ai-platform — 環境変数の見本
#
# ローカル: このファイルを .env にコピーして使う。
#   docker compose だけなら .env は無くてよい（開発用の既定値が docker-compose.yml にある。置けば .env が優先）。
#   ⚠️ 下の JWT_SECRET の見本値と compose の既定値は公開されているので、本番の api-gateway は起動を拒否する。
# 本番:     web は Vercel、api-gateway / ai-engine / n8n は Render（render.yaml）で設定する。
#
# 各変数の読み口（ここ以外で process.env / os.environ を読まない）:
#   [gw]  apps/api-gateway/src/config/env.ts（envSchema と ENV_DEFAULTS）
#   [ai]  apps/ai-engine/app/config.py（Settings）
#   [web] apps/web の import.meta.env（ビルド時に埋め込まれる VITE_*）
#   [ops] scripts/*.mjs・packages/db-schema/prisma/*.ts などの運用スクリプト
#
# 書式: 「必須」以外はすべて任意。コメントアウトしてある行の値が既定値。
# ⚠️ シークレットの実値をこのファイルに書かない（コミットされる）。
# ==========================================================================

# ------ 共通 ------
# [gw] production 以外では Prisma のクエリログ等が有効になる。本番は production にする
NODE_ENV=development
# [gw] api-gateway の待受ポート
# PORT=4000
# [gw] 前に立つプロキシの段数（既定 1 = Render）。レート制限の IP を X-Forwarded-For から取る。
#   0 なら転送ヘッダを信じない（直接公開するとき）。⚠️ 段数が実際より多いと利用者がヘッダを書いて制限をすり抜けられる
# TRUST_PROXY_HOPS=1

# [gw][ai] 必須。PostgreSQL（本番 = Supabase）。ローカルは docker-compose の postgres。
#   [ai] は AILog / RiskEvent の書き込みと月間利用量の集計に使う。未設定時の既定は
#   file:./data/app.db（SQLite・旧来のローカル用）だが、スキーマは Postgres 前提なので設定すること。
# NOTE: 2026-08 に Neon から移行済み。Neon は 2026-07-08 で更新が止まった旧 DB。
# 書式: postgresql://USER:PASS@HOST:PORT/DB?sslmode=require
DATABASE_URL=postgresql://orgai:orgai-dev-password@localhost:5432/orgai

# ------ 認証 [gw] ------
# 必須。32 文字未満だと api-gateway が起動しない。生成例: openssl rand -hex 32
JWT_SECRET=change_me_minimum_32_characters_required_xxxxxxxx
# JWT_EXPIRES_IN=24h
# 招待リンクの有効日数
# INVITE_TTL_DAYS=7
# OAuth の state 署名鍵。未設定なら JWT_SECRET から用途別に派生する
# （ログイン JWT と同じ鍵で署名すると state が API のベアラトークンとして通ってしまうため分離）
# OAUTH_STATE_SECRET=

# ------ LLM プロバイダ [ai]（松竹梅ルーティング: ai-engine の LLMRouter） ------
# 梅(STARTER)・竹(PRO) → Gemini (無料枠 / 梅=flash-lite, 竹=flash)
# 松(MAX)・admin       → Anthropic Claude (json=Haiku, 本文=Sonnet/Opus)
# エージェント構築(/plan/agent) は全ユーザー Opus 固定。詳細: docs/llm-provider-tiers.md
# 必須（未設定でも起動はするが、/ready が degraded になり Claude 呼び出しが失敗する）
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# [ai][gw] Google AI Studio (aistudio.google.com) の API キー。
#   [ai] 未設定なら梅/竹も Anthropic にフォールバック（＝課金注意）
#   [gw] EMBEDDING_PROVIDER=gemini（既定）のとき、RAG の埋め込みにも流用する
GEMINI_API_KEY=
# [ai][gw] ⚠️ 無料枠は「入力が Google の製品改善に使われる」と明記されている。有料のお客さまを
#      乗せる前に有料課金へ切り替えること。切り替えたら true にする（1/true/yes で有効）。
#      [gw] は設定 > 基本 の「セットアップ状況」の表示にだけ使う（ai-engine と同じ値を入れる）
# GEMINI_PAID_TIER=false
# [ai] admin 判定（カンマ区切り email、大文字小文字は無視）。一致ユーザーは常に Claude
ADMIN_EMAILS=
# [ai] Gemini モデルの上書き
# GEMINI_MODEL_UME=gemini-2.5-flash-lite
# GEMINI_MODEL_TAKE=gemini-2.5-flash
# 構造化処理（JSON）用。未設定なら GEMINI_MODEL_UME と同じ
# GEMINI_MODEL_JSON=

# ------ 埋め込み / RAG [gw] ------
# Anthropic に埋め込み API は無いため別プロバイダを使う。キーが無ければ RAG（ファイル根拠付け・
# 過去チャット横断参照）は静かに無効化され、チャットは従来通り動く。
# 出力次元は 1024 固定（DB の vector(1024) と一致）。プロバイダ切替時もこの次元を維持すること。
#   - gemini (既定): gemini-embedding-001。キーは EMBEDDING_API_KEY → GEMINI_API_KEY の順
#   - voyage:        EMBEDDING_MODEL=voyage-3 (native 1024)
#   - openai:        EMBEDDING_MODEL=text-embedding-3-small (dimensions=1024)
# EMBEDDING_PROVIDER=gemini
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=
# EMBEDDING_DIM=1024

# ------ サービス間 URL ------
# [gw] CORS の許可オリジン（カンマ区切り・完全一致）。本番は Vercel のドメインを含める
FRONTEND_URL=http://localhost:3000
# [gw] 自分自身の公開 URL（OAuth のリダイレクト URI などに使う）
# [ai] CORS の許可オリジン（カンマ区切り）
API_GATEWAY_URL=http://localhost:4000
# [gw] ai-engine の URL（既定 http://localhost:8000）。docker-compose では http://ai-engine:8000 を compose が渡す
AI_ENGINE_URL=http://localhost:8000

# ------ ai-engine の内部呼び出し [gw][ai] ------
# ⚠️ ai-engine は Render の web サービス = 公開 URL を持つ。未設定だと URL を知る第三者が
#    /llm/chat や /vision/receipt を直接叩け、Anthropic の課金がこちら持ちで発生し、
#    任意の org_id で AILog に行を書き込める。CORS はブラウザ向けで curl には効かない。
#    api-gateway と ai-engine に **同じ値** を設定して初めて有効になる（片方だけなら素通し）。
#    生成例: openssl rand -hex 32
# INTERNAL_API_TOKEN=

# ------ CORS [gw] ------
# FRONTEND_URL(カンマ区切り)の完全一致に加えて許可するホスト名（カンマ区切り）。既定は本番エイリアス。
# ALLOWED_ORIGIN_HOSTS=org-ai-platform.vercel.app
# Vercel のプレビュー/デプロイ毎 URL を許可するアカウント固有サフィックス（既定値は env.ts を参照）
# VERCEL_PREVIEW_SUFFIX=

# ------ n8n [gw][ops]（任意） ------
# 設定が無い・到達できない場合は AI Engine 単体で実行される。
#
# 起動方式 (どれか):
#   - Render: N8N_CLOUD_URL=https://org-ai-n8n-web.onrender.com
#   - n8n Cloud: N8N_CLOUD_URL=https://<tenant>.app.n8n.cloud
#   - ローカル: N8N_URL=http://localhost:5678 のみで OK (N8N_CLOUD_URL は未設定)
# 優先順は N8N_CLOUD_URL → N8N_URL → http://localhost:5678。
#
# Webhook 経由でワークフローを起動する。apps/n8n-workflows/*.json をインポートし
# `Header Auth` クレデンシャル (Name: x-org-ai-token, Value: $N8N_WEBHOOK_AUTH_TOKEN) を
# 各 Webhook ノードに割り当ててからアクティブ化すること（docs/n8n-setup.md）。
# N8N_URL=http://localhost:5678
# N8N_CLOUD_URL=https://org-ai-n8n-web.onrender.com
# N8N_API_KEY=                  # Public API キー (active ワークフローの判定に使用 / 任意)
# N8N_WEBHOOK_AUTH_TOKEN=       # Webhook Header Auth のトークン (n8n と一致させる)
#   ⚠️ 未設定だと既定値（コードとドキュメントに書いてある＝公開されている値）になる。本番では必ず変える
#   ⚠️ NODE_ENV=production で未設定・既定値のままだと api-gateway は起動しない（config/startup-checks.ts）
# n8n のコールバック（task-complete / task-log / scheduled-job-complete）の body に orgId を必須にするか。
#   既定（未設定/false）は移行期間: orgId が無い古いワークフローは警告ログを出して通す（ある場合は照合する）。
#   ワークフローを作り直して警告が出なくなったら true にする（docs/design/multi-tenancy.md E1 / Q6）
# N8N_CALLBACK_ORG_REQUIRED=false
# N8N_TIMEOUT_MS=30000          # capability-resolver から n8n webhook を叩く際のタイムアウト (ms)

# ------ 業務ページ [gw]（docs/design/custom-pages.md） ------
# 業務ページのデータ取得・送信は gateway が ${N8N_CLOUD_URL|N8N_URL}/webhook/pages/<orgId>/<hook> を叩く（共有トークンは上の値）。
# n8n が未設定ならページは開くがデータ部は「未接続」（ai-engine へのフォールバックはしない）。
# 開発用: true で seed の sampleData を n8n の代わりに返す（n8n 無しで画面を確かめる）。NODE_ENV=production では常に無効
PAGES_SAMPLE_MODE=true
# PAGE_ACTION_TIMEOUT_MS=10000  # n8n の応答を待つ時間 (ms)。重い処理は受け付けだけ返して別ワークフローへ

# ------ Capability Registry [gw] ------
# 未対応 capability 要望時に Slack 通知が飛ぶチャンネル名 (notify_slack capability に渡す)
# ADMIN_SLACK_CHANNEL=#org-ai-admin
# rawInput 推論の確信度がこれ未満なら実行せず確認 (NEEDS_CONFIRMATION) を返す (0-1)
# CAPABILITY_CONFIDENCE_THRESHOLD=0.7

# ------ セルフサーブ連携 (設定 > 連携) [gw] ------
# 外部サービス資格情報の暗号化鍵 (32byte を hex/base64)。未設定時は JWT_SECRET から導出
# CHANNEL_CREDENTIAL_ENC_KEY=
# Google 連携: GCP の OAuth クライアント (ウェブアプリ)。docs/oauth-setup.md
# リダイレクト URI に ${API_GATEWAY_URL}/api/oauth/google/callback を登録すること
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# ------ 定期実行・運用 [gw] ------
# 定期実行の gateway 内 tick (5分間隔)。false のときだけ無効。n8n schedule-dispatcher と併走しても二重発火しない
# INTERNAL_SCHEDULER_ENABLED=true
# SIGTERM 受信後、実行中の処理の完了を待つ最大時間 (ms)
# SHUTDOWN_DRAIN_MS=20000
# 業務フローの gateway 全体の同時実行数（超えた分は QUEUED で待つ。組織ごとの上限はプランで別にある）
# FLOW_MAX_CONCURRENCY=16
# usage-metrics-svc（Go）の URL。/api/analytics/departments が中継する
# METRICS_URL=http://localhost:8080

# ------ ファイル保存 (Supabase Storage) [gw] ------
# ⚠️ 本番では必須。未設定だとローカルディスクに保存し、Render では次のデプロイで実体が消える
#    （起動後の最初の保存で警告ログが出る）。
#    バケットは **非公開** で作ること。api-gateway が service_role キーで読み書きし、
#    組織の切り分けはアプリ側（キーの先頭が orgId）で担保する。キーはブラウザに渡さない。
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=org-files
# 開発時のローカル保存先（既定: リポジトリ直下の data/files）
# FILES_DIR=

# ------ 決済 (Stripe) [gw] ------ 詳細: docs/billing.md
# 未設定なら設定 > プラン は「準備中」を出すだけで、他の機能には影響しない。
# ⚠️ 金額はコードに持たない。Stripe ダッシュボードで作った price の ID を指す（値上げでデプロイ不要）
# テストモードの用意と下の値の取得は `STRIPE_SECRET_KEY=sk_test_... npm run stripe:bootstrap -- --apply`
# 「決済設定済み」（期限切れトライアルを閲覧のみにする）は STRIPE_SECRET_KEY・STRIPE_PRICE_STARTER_MONTHLY・
# STRIPE_WEBHOOK_SECRET の 3 つがそろったとき。署名鍵が無いと /api/billing/checkout は 503（支払っても反映されないため）
# STRIPE_SECRET_KEY=
# webhook の署名鍵。未設定なら webhook を受け付けない（エンドポイント: /api/webhooks/stripe）
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_STARTER_MONTHLY=
# STRIPE_PRICE_STARTER_YEARLY=
# STRIPE_PRICE_PRO_MONTHLY=
# STRIPE_PRICE_PRO_YEARLY=
# STRIPE_PRICE_MAX_MONTHLY=
# STRIPE_PRICE_MAX_YEARLY=
# 追加ストレージの月額（数量課金の price）
# STRIPE_PRICE_STORAGE_ADDON=
# 消費税 10%（外税）の tax rate。価格は税抜で作るので本番では必ず設定する
# STRIPE_TAX_RATE_ID=
# 登録時トライアル（カード不要）の日数。期限後は未契約なら閲覧のみ（上の 3 つがそろったときだけ）。下限 1（0 以下は既定の 30）
# BILLING_TRIAL_DAYS=30
# Checkout とポータルから戻る先（フロントの公開 URL）。利用者の入力からは作らない
# APP_BASE_URL=http://localhost:3000

# ai-engine: X-Org-Id ヘッダと body の org_id の照合（ai-engine 側の環境変数。docs/design/multi-tenancy.md §7.2）
#   off     … 照合しない（緊急時の切り戻し用）
#   warn    … 既定。食い違いは 403、ヘッダ無しは警告ログを出して通す（n8n 経由などの洗い出し用）
#   enforce … ヘッダ無しも 403。warn で「X-Org-Id がありません」のログが0件になったら切り替える
# ORG_HEADER_MODE=warn

# RLS Phase 2a [gw][ai]（docs/design/multi-tenancy.md §17）。gateway と ai-engine に同じ値を入れる
#   off … 既定。今までどおり（アプリ層の tenantDb だけで分離）
#   on  … AILog / RiskEvent / FileChunk / MessageEmbedding と raw SQL を、同じトランザクションで
#         set_config('app.org_id', <orgId>, true) してから流す。packages/db-schema/rls/phase2a.sql を流し、
#         DATABASE_URL の接続ユーザーを flow_app（NOBYPASSRLS）に替えるのと同時に on にする
#         （on にせず flow_app に替えると 4 表が 0 行に見える。off のまま所有者で繋いでいれば何も変わらない）
# RLS_MODE=off

# ------ カスタム HTTP ノード (チャットから作る外部API接続) [gw] ------
# 全社的なキルスイッチ。false にすると保存済みノードも実行されなくなる（事故時の緊急停止用）
# HTTP_NODE_ENABLED=true
# org あたりの毎分の送信上限。自社 IP から第三者 API を乱打してレピュテーションを落とさないための保険
# HTTP_NODE_RATE_PER_MIN=60
# 1リクエストの既定タイムアウト(ms)。ノード個別の timeoutMs が優先され、上限は 30000
# HTTP_NODE_TIMEOUT_MS=15000
# 応答の読み取り上限(byte)。超えたらストリームを打ち切って失敗にする
# HTTP_NODE_MAX_RESPONSE_BYTES=262144
# 運用で足す拒否ホスト（カンマ区切り）
# HTTP_NODE_BLOCKED_HOSTS=
# 許可するポート（カンマ区切り）。未設定なら url-guard.ts の既定リスト
# HTTP_NODE_ALLOWED_PORTS=
# ⚠️ 内部ホストの拒否リストは N8N_URL / AI_ENGINE_URL / API_GATEWAY_URL / DATABASE_URL から
#    自動生成される。Render ではこれらが公開 DNS 名 (*.onrender.com) なので、
#    プライベート IP のブロックでは捕まらない。**本番での実質的な最重要防御がこれ**なので、
#    サービスを増やしたら該当の環境変数を必ず設定すること。

# ------ 運用スクリプト [ops] ------
# scripts/render-deploy.mjs（npm run render:*）が使う Render の API キー
# RENDER_API_KEY=
# packages/db-schema/prisma/seed-capabilities.ts の投入先組織。未設定なら最古の組織
# ORG_ID=

# ==========================================================================
# apps/web (Vite) [web] — ビルド時に埋め込まれる。apps/web/.env.local に書く。
# 本番（Vercel）ではビルド環境変数として設定する。docker-compose では build args で渡している。
# ==========================================================================
# API のベース URL（既定: /api ＝ 同一オリジン。dev は vite の proxy が gateway へ中継する）
# VITE_API_URL=https://org-ai-api-gateway.onrender.com/api
# WebSocket のベース URL（既定: 開いているページと同じホスト）
# VITE_WS_URL=wss://org-ai-api-gateway.onrender.com
# usage-metrics-svc の直叩き先（gateway 経由に失敗したときだけ使う。dev の既定は localhost:8080）
# VITE_METRICS_URL=
# dev サーバの /api プロキシ先（vite.config.ts。既定: http://localhost:4000）
# VITE_PROXY_TARGET=

# 注: ブラウザから LLM API を直接呼び出すことは禁止。LLM 呼び出しは必ず API Gateway 経由 (/api/llm/chat) で行う。
