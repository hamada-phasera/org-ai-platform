# ==========================================================================
# FLOW / org-ai-platform — environment variables
# Copy this file to .env (local) and configure per environment.
# For production, set these in Vercel (web) and Render (gateway + ai-engine).
# ==========================================================================

# ------ Shared ------
NODE_ENV=development

# PostgreSQL (Neon in prod). Local dev can use docker-compose postgres.
# Format: postgresql://USER:PASS@HOST/DB?sslmode=require
DATABASE_URL=postgresql://orgai:orgai-dev-password@localhost:5432/orgai

# Generate with: openssl rand -hex 32
JWT_SECRET=change_me_minimum_32_characters_required_xxxxxxxx

# ------ LLM providers (松竹梅ルーティング: ai-engine LLMRouter) ------
# 梅(STARTER)・竹(PRO) → Gemini (無料枠 / 梅=flash-lite, 竹=flash)
# 松(MAX)・admin       → Anthropic Claude (json=Haiku, 本文=Sonnet/Opus)
# エージェント構築(/plan/agent) は全ユーザー Opus 固定
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Google AI Studio (aistudio.google.com) の無料 API キー。
# 未設定でも起動する（梅/竹 も Anthropic に安全フォールバック＝課金注意）
GEMINI_API_KEY=
# admin 判定（カンマ区切り email、大文字小文字は無視）。一致ユーザーは常に Claude
ADMIN_EMAILS=
# Gemini モデルの上書き（省略時: 梅=gemini-2.5-flash-lite / 竹=gemini-2.5-flash）
# GEMINI_MODEL_UME=gemini-2.5-flash-lite
# GEMINI_MODEL_TAKE=gemini-2.5-flash

# ------ 埋め込み / RAG (api-gateway) ------
# Anthropic に埋め込み API は無いため別プロバイダを使う。未設定なら RAG (ファイル根拠付け・
# 過去チャット横断参照) は静かに無効化され、チャットは従来通り動く。
# 出力次元は 1024 固定 (DB の vector(1024) と一致)。プロバイダ切替時もこの次元を維持すること。
#   - Voyage AI (推奨): EMBEDDING_PROVIDER=voyage / EMBEDDING_MODEL=voyage-3 (native 1024)
#   - OpenAI (代替):   EMBEDDING_PROVIDER=openai / EMBEDDING_MODEL=text-embedding-3-small (dimensions=1024)
# EMBEDDING_API_KEY=
# EMBEDDING_PROVIDER=voyage
# EMBEDDING_MODEL=voyage-3
# EMBEDDING_DIM=1024

# ------ Service URLs (server-to-server) ------
FRONTEND_URL=http://localhost:3000
API_GATEWAY_URL=http://localhost:4000
AI_ENGINE_URL=http://localhost:8000

# ------ n8n integration (optional) ------
# n8n を使う場合のみ設定。設定が無い・到達できない場合は AI Engine 単体で実行される。
#
# 起動方式 (どれか):
#   - Render: N8N_CLOUD_URL=https://org-ai-n8n-web.onrender.com
#   - n8n Cloud: N8N_CLOUD_URL=https://<tenant>.app.n8n.cloud
#   - ローカル: N8N_URL=http://localhost:5678 のみで OK (N8N_CLOUD_URL は未設定)
#
# Webhook 経由でワークフローを起動する設計に変更済み。dept-*.json をインポートし
# `Header Auth` クレデンシャル (Name: x-org-ai-token, Value: $N8N_WEBHOOK_AUTH_TOKEN) を
# 各 Webhook ノードに割り当ててからアクティブ化すること。
# N8N_URL=http://localhost:5678
# N8N_CLOUD_URL=https://org-ai-n8n-web.onrender.com
# N8N_API_KEY=                  # Public API キー (active ワークフローの判定に使用 / 任意)
# N8N_WEBHOOK_AUTH_TOKEN=       # Webhook Header Auth のトークン (n8n と一致させる)
# N8N_TIMEOUT_MS=30000          # capability-resolver から n8n webhook を叩く際のタイムアウト (ms)

# ------ Capability Registry ------
# 未対応 capability 要望時に Slack 通知が飛ぶチャンネル名 (notify_slack capability に渡す)
# ADMIN_SLACK_CHANNEL=#org-ai-admin
# rawInput 推論の確信度がこれ未満なら実行せず確認 (NEEDS_CONFIRMATION) を返す (0-1)
# CAPABILITY_CONFIDENCE_THRESHOLD=0.7

# ------ CORS ------
# FRONTEND_URL(カンマ区切り)の完全一致に加えて許可するホスト名。既定は本番エイリアス。
# ALLOWED_ORIGIN_HOSTS=org-ai-platform.vercel.app
# Vercel のプレビュー/デプロイ毎 URL を許可するアカウント固有サフィックス（他人は取得できない）
# VERCEL_PREVIEW_SUFFIX=-hamahiro1668s-projects.vercel.app

# ------ セルフサーブ連携 (設定 > 連携) ------
# LINE 受信箱: チャネル資格情報の暗号化鍵 (32byte を hex/base64)。未設定時は JWT_SECRET から導出
# CHANNEL_CREDENTIAL_ENC_KEY=
# Google 連携: GCP の OAuth クライアント (ウェブアプリ)。
# リダイレクト URI に ${API_GATEWAY_URL}/api/oauth/google/callback を登録すること
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# OAuth の state 署名鍵。未設定なら JWT_SECRET から用途別に派生する
# （ログイン JWT と同じ鍵で署名すると state が API のベアラトークンとして通ってしまうため分離）
# OAUTH_STATE_SECRET=
# 定期実行の gateway 内 tick (5分間隔)。n8n schedule-dispatcher と併走しても二重発火しない
# INTERNAL_SCHEDULER_ENABLED=true

# ------ ai-engine の内部呼び出し ------
# ⚠️ ai-engine は Render の web サービス = 公開 URL を持つ。未設定だと URL を知る第三者が
#    /llm/chat や /vision/receipt を直接叩け、Anthropic の課金がこちら持ちで発生し、
#    任意の org_id で AILog に行を書き込める。CORS はブラウザ向けで curl には効かない。
#    api-gateway と ai-engine に **同じ値** を設定して初めて有効になる（片方だけなら素通し）。
#    生成例: openssl rand -hex 32
# INTERNAL_API_TOKEN=

# ------ カスタム HTTP ノード (チャットから作る外部API接続) ------
# 全社的なキルスイッチ。false にすると保存済みノードも実行されなくなる（事故時の緊急停止用）
# HTTP_NODE_ENABLED=true
# org あたりの毎分の送信上限。自社 IP から第三者 API を乱打してレピュテーションを落とさないための保険
# HTTP_NODE_RATE_PER_MIN=60
# 1リクエストの既定タイムアウト(ms)。ノード個別の timeoutMs が優先され、上限は 30000
# HTTP_NODE_TIMEOUT_MS=15000
# 応答の読み取り上限(byte)。超えたらストリームを打ち切って失敗にする
# HTTP_NODE_MAX_RESPONSE_BYTES=262144
# ⚠️ 内部ホストの拒否リストは N8N_URL / AI_ENGINE_URL / API_GATEWAY_URL / DATABASE_URL から
#    自動生成される。Render ではこれらが公開 DNS 名 (*.onrender.com) なので、
#    プライベート IP のブロックでは捕まらない。**本番での実質的な最重要防御がこれ**なので、
#    サービスを増やしたら該当の環境変数を必ず設定すること。

# ==========================================================================
# apps/web (Vite) build-time variables — put these in apps/web/.env.local
# In production (Vercel), set them as build env vars.
# ==========================================================================
# VITE_API_URL=https://org-ai-api-gateway.onrender.com/api
# VITE_WS_URL=wss://org-ai-api-gateway.onrender.com

# 注: ブラウザから LLM API を直接呼び出すことは禁止。LLM 呼び出しは必ず API Gateway 経由 (/api/llm/chat) で行う。
