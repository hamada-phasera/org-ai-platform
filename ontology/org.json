{
  "id": "https://org-ai-platform.local/ontology",
  "version": "0.2.0",
  "source": {
    "schema": "packages/db-schema/prisma/schema.prisma",
    "measuredAt": "2026-09-13",
    "database": "Supabase (prod)",
    "_note": "本番は Supabase。Neon は 2026-07 で止まった旧 DB で、参照しないこと"
  },
  "schemes": {
    "department": {
      "label": "部署",
      "boundTo": [
        "Task.department",
        "Agent.department",
        "AILog.department",
        "Capability.department",
        "ScheduledTask.department",
        "Message.department"
      ],
      "coverage": [
        {
          "from": "Task.department",
          "by": "Agent.department",
          "severity": "warn",
          "note": "タスクが発生する部署には、担当エージェントが存在するべき"
        },
        {
          "from": "Task.department",
          "by": "AILog.department",
          "severity": "warn",
          "note": "AI 実行は部署つきで監査ログに残るべき。SALES が無いのは、集中ロギングを入れる前の古い行が2件残っているだけ（/llm/chat は department つきで記録する。2026-09-13 にゲートウェイ側の二重記録も解消）"
        }
      ],
      "concepts": [
        {
          "id": "GENERAL",
          "prefLabel": "全社共通",
          "altLabel": [
            "共通",
            "その他",
            "未分類"
          ],
          "status": "active"
        },
        {
          "id": "SALES",
          "prefLabel": "営業",
          "altLabel": [
            "セールス",
            "営業部",
            "Sales"
          ],
          "status": "active"
        },
        {
          "id": "MARKETING",
          "prefLabel": "マーケティング",
          "altLabel": [
            "マーケ",
            "販促"
          ],
          "status": "active"
        },
        {
          "id": "ACCOUNTING",
          "prefLabel": "経理",
          "altLabel": [
            "会計",
            "経理部",
            "財務"
          ],
          "status": "active"
        },
        {
          "id": "ANALYTICS",
          "prefLabel": "分析",
          "altLabel": [],
          "status": "active",
          "note": "実データ（Capability.department）に存在し、コードの許可リストにもある。語彙側が漏れていた"
        },
        {
          "id": "SNS",
          "prefLabel": "SNS運用",
          "altLabel": [
            "ソーシャル"
          ],
          "status": "planned",
          "note": "UI の選択肢にはあるが実データに存在しない。実装されたら active にする"
