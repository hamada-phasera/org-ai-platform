          "note": "schema の default だが実データに 0 件。既定値と実際の初期状態がずれている"
        },
        {
          "id": "QUEUED",
          "prefLabel": "待機中",
          "altLabel": [],
          "status": "active"
        },
        {
          "id": "DONE",
          "prefLabel": "完了",
          "altLabel": [],
          "status": "active",
          "note": "成果物はこの状態の Task を指す。専用テーブルは存在しない"
        },
        {
          "id": "FAILED",
          "prefLabel": "失敗",
          "altLabel": [],
          "status": "active"
